{
  "name": "shujian-agent-bridge",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "description": "HTTP/SSE bridge that wraps @cursor/sdk so any host (Rust, dashboard, Cloudflare-tunnelled Mac mini, cloud agent) can drive Cursor agents.",
  "type": "module",
  "engines": {
    "bun": ">=1.3.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ShukriChiu/shujian-agent-bridge.git"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --env-file=.env --watch src/server.ts",
    "dev:bun": "bun --watch src/server.ts",
    "start": "node --experimental-strip-types --env-file=.env src/server.ts",
    "start:bun": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "test:cloud": "bun scripts/test-cloud-multi.ts"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.12",
    "@hono/node-server": "^2.0.4",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  }
}
