PORT=8003
DEFAULT_MODEL=composer-2

# Optional: where local agents `cd` before running. Falls back to $HOME.
DEFAULT_CWD=/Users/you/code

# Optional: a human-friendly name for THIS bridge instance.
# Shown in the dashboard's bridge registry. Useful when you have many
# Mac minis behind Cloudflare Tunnel ("mac-mini-studio", "macmini-shed", ...).
BRIDGE_NAME=local

# Headless / CI fallbacks. In normal use the dashboard supplies
# CURSOR_API_KEY and CURSOR_SESSION_TOKEN via request headers
# (X-Cursor-Api-Key / X-Cursor-Session-Token).
# CURSOR_API_KEY=crsr_...
# CURSOR_SESSION_TOKEN=user_xxx::eyJ...
