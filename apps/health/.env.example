# Same Postgres as apps/backend (Railway PG in production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shujian_backend

# Default tenant (was BRAIN_PROFILE / HEALTH_OWNER)
HEALTH_OWNER=shujian

# Per-tenant secrets can live in health.tenants (preferred for multi-tenant).
# These env vars seed the default tenant on `health init`.
OURA_PAT=
SINO_USER_ID=

# SINO OAuth (service-level; one account pulls CGM for all tenants)
SINO_CLIENT_ID=
SINO_CLIENT_SECRET=
# Or pre-encoded: SINO_CLIENT_BASIC=Basic xxx
ICAN_USERNAME=
ICAN_PASSWORD=
# Fallback static tokens (dev only)
ICAN_TOKEN=
SINO_ACCESS_TOKEN=
SINO_REFRESH_MARGIN_SECONDS=3600
SINO_TOKEN_REFRESH_LOOP_SECONDS=120

# HTTP server
PORT=8090
HOST=0.0.0.0

# Daily sync cron (UTC hour, default 1 = 09:00 Asia/Shanghai)
SYNC_CRON_HOUR=1
ENABLE_SCHEDULER=true
