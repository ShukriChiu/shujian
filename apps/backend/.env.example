DATABASE_URL=postgres://postgres:postgres@localhost:5432/shujian_backend
PORT=8080
HOST=0.0.0.0
SESSION_TTL_DAYS=30

# Seed admin (only used on first boot when no tenant exists)
SEED_TENANT_SLUG=onion
SEED_TENANT_NAME=趣学洋葱
SEED_TENANT_DISPLAY_NAME=趣学洋葱教育咨询有限公司
SEED_ADMIN_IDENTIFIER=admin
SEED_ADMIN_PASSWORD=admin

# Comma-separated origins for CORS. Use "*" for unrestricted (no creds).
CORS_ALLOW_ORIGINS=http://localhost:5173,https://shujian-dashboard.pages.dev
