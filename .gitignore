# Secrets — never commit env files
**/.env
**/.env.*
!**/.env.example

# Node / Bun
node_modules/
*.tsbuildinfo
dist/
.vite/

# Bun lockfile binary form is fine to commit, but ignore extra caches
.bun/

# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage
coverage/
.nyc_output/
